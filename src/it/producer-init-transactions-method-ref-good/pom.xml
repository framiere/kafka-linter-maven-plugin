<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.conductor.kafkalinter.it</groupId>
    <artifactId>producer-init-transactions-method-ref-good</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>4.1.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.conductor</groupId>
                <artifactId>kafka-linter-maven-plugin</artifactId>
                <version>0.1.0-SNAPSHOT</version>
                <configuration>
                    <severities>
                        <!--
                          Whole point: the project's ONLY initTransactions reference is a
                          method reference (`producer::initTransactions`). The project also
                          contains txn-lifecycle calls (beginTransaction, commitTransaction,
                          ...) which would normally fire the rule. If the rule's project-wide
                          initTransactions detector still walked only MethodInsnNode, the
                          method-ref capture would be invisible, hasInit would be false, and
                          this build would fail with several PRODUCER_INIT_TRANSACTIONS_NOT_CALLED
                          violations. The fact that this IT is configured with
                          invoker.buildResult=success means the indy bootstrap-handle scan is
                          working — the suppressor sees the method-ref initTransactions and
                          silences the rule for the whole project.
                        -->
                        <PRODUCER_INIT_TRANSACTIONS_NOT_CALLED>ERROR</PRODUCER_INIT_TRANSACTIONS_NOT_CALLED>
                    </severities>
                </configuration>
                <executions>
                    <execution>
                        <id>lint</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
