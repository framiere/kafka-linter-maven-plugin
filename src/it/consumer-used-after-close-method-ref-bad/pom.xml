<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.conductor.kafkalinter.it</groupId>
    <artifactId>consumer-used-after-close-method-ref-bad</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.7.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.conductor</groupId>
                <artifactId>kafka-linter-maven-plugin</artifactId>
                <version>0.1.0-SNAPSHOT</version>
                <configuration>
                    <severities>
                        <!--
                          Every bad fixture in this IT closes the consumer FIRST, then
                          captures a `consumer::<lifecycle>` method reference into an
                          executor / forEach / CompletableFuture. The captured
                          functional-interface, when invoked, will throw
                          IllegalStateException("This consumer has already been closed").
                          Without the indy bootstrap-handle scan in
                          ConsumerUsedAfterCloseRule, the rule walks only
                          MethodInsnNode and reports ZERO violations for these
                          shapes — a silent false-negative. With the fix, the rule
                          fires on each method-ref site; invoker.buildResult=failure
                          asserts at least one ERROR was emitted.
                        -->
                        <CONSUMER_USED_AFTER_CLOSE>ERROR</CONSUMER_USED_AFTER_CLOSE>
                        <CONSUMER_NOT_CLOSED>OFF</CONSUMER_NOT_CLOSED>
                        <CONSUMER_CLOSE_NO_TIMEOUT>OFF</CONSUMER_CLOSE_NO_TIMEOUT>
                        <CONSUMER_NOT_THREAD_SAFE>OFF</CONSUMER_NOT_THREAD_SAFE>
                        <CONSUMER_POLL_RESULT_IGNORED>OFF</CONSUMER_POLL_RESULT_IGNORED>
                        <CONSUMER_SEEK_BEFORE_POLL>OFF</CONSUMER_SEEK_BEFORE_POLL>
                        <CONSUMER_POLL_INFINITE_DURATION>OFF</CONSUMER_POLL_INFINITE_DURATION>
                        <CONSUMER_NO_WAKEUP_SHUTDOWN>OFF</CONSUMER_NO_WAKEUP_SHUTDOWN>
                        <COMMIT_ASYNC_NO_FINAL_SYNC>OFF</COMMIT_ASYNC_NO_FINAL_SYNC>
                        <KAFKA_CLIENTS_CVE_CONFIG_PROVIDER>OFF</KAFKA_CLIENTS_CVE_CONFIG_PROVIDER>
                        <KAFKA_CLIENTS_CVE_BUFFER_POOL>OFF</KAFKA_CLIENTS_CVE_BUFFER_POOL>
                        <KAFKA_CLIENTS_CVE_SCRAM_REPLAY>OFF</KAFKA_CLIENTS_CVE_SCRAM_REPLAY>
                    </severities>
                </configuration>
                <executions>
                    <execution>
                        <id>lint</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
