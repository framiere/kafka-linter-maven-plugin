<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.conductor.kafkalinter.it</groupId>
    <artifactId>consumer-subscribe-and-assign-mixed-bad</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.7.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.conductor</groupId>
                <artifactId>kafka-linter-maven-plugin</artifactId>
                <version>0.1.0-SNAPSHOT</version>
                <configuration>
                    <severities>
                        <!--
                          Each BAD method puts the same KafkaConsumer slot into
                          both modes (subscribe-then-assign, assign-then-subscribe,
                          subscribe-then-capture-assign-method-ref) — each must
                          fire once. GoodConsumerSingleMode holds the silent
                          controls: subscribe-only, assign-only, and the
                          documented subscribe-unsubscribe-assign mode-switch.
                        -->
                        <CONSUMER_SUBSCRIBE_AND_ASSIGN_MIXED>ERROR</CONSUMER_SUBSCRIBE_AND_ASSIGN_MIXED>
                        <!-- Silence the coarse class-scoped sibling so the build outcome reflects only the slot-scoped rule under test. -->
                        <CONSUMER_ASSIGN_AND_SUBSCRIBE>OFF</CONSUMER_ASSIGN_AND_SUBSCRIBE>
                        <!-- Silence ambient consumer siblings so the build outcome reflects only the rule under test. -->
                        <CONSUMER_NOT_CLOSED>OFF</CONSUMER_NOT_CLOSED>
                        <CONSUMER_CLOSE_NO_TIMEOUT>OFF</CONSUMER_CLOSE_NO_TIMEOUT>
                        <CONSUMER_NOT_THREAD_SAFE>OFF</CONSUMER_NOT_THREAD_SAFE>
                        <CONSUMER_POLL_RESULT_IGNORED>OFF</CONSUMER_POLL_RESULT_IGNORED>
                        <CONSUMER_SEEK_BEFORE_POLL>OFF</CONSUMER_SEEK_BEFORE_POLL>
                        <CONSUMER_POLL_INFINITE_DURATION>OFF</CONSUMER_POLL_INFINITE_DURATION>
                        <CONSUMER_NO_WAKEUP_SHUTDOWN>OFF</CONSUMER_NO_WAKEUP_SHUTDOWN>
                        <CONSUMER_SUBSCRIBE_IN_LOOP>OFF</CONSUMER_SUBSCRIBE_IN_LOOP>
                        <CONSUMER_SUBSCRIBE_WITHOUT_REBALANCE_LISTENER>OFF</CONSUMER_SUBSCRIBE_WITHOUT_REBALANCE_LISTENER>
                        <COMMIT_ASYNC_NO_FINAL_SYNC>OFF</COMMIT_ASYNC_NO_FINAL_SYNC>
                        <CLIENT_ID_MISSING>OFF</CLIENT_ID_MISSING>
                        <KAFKA_CLIENTS_CVE_CONFIG_PROVIDER>OFF</KAFKA_CLIENTS_CVE_CONFIG_PROVIDER>
                        <KAFKA_CLIENTS_CVE_BUFFER_POOL>OFF</KAFKA_CLIENTS_CVE_BUFFER_POOL>
                        <KAFKA_CLIENTS_CVE_SCRAM_REPLAY>OFF</KAFKA_CLIENTS_CVE_SCRAM_REPLAY>
                    </severities>
                </configuration>
                <executions>
                    <execution>
                        <id>lint</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
