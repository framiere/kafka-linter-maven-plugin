<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.conductor.kafkalinter.it</groupId>
    <artifactId>streams-used-after-close-bad</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams</artifactId>
            <version>3.7.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.conductor</groupId>
                <artifactId>kafka-linter-maven-plugin</artifactId>
                <version>0.1.0-SNAPSHOT</version>
                <configuration>
                    <severities>
                        <!--
                          Each BAD method below constructs a KafkaStreams,
                          immediately calls close(), then performs ONE
                          lifecycle call on the same slot. Each shape must
                          fire once. invoker.buildResult=failure asserts at
                          least one ERROR was emitted.

                          GoodStreamsCloseOrder.java holds the silent
                          controls including the all-important cleanUp()
                          exception (documented safe in NOT_RUNNING),
                          state() / metrics() (excluded from the lifecycle
                          set), correct start-before-close order, and a
                          two-slot case where closing slot A does not
                          taint slot B.
                        -->
                        <STREAMS_USED_AFTER_CLOSE>ERROR</STREAMS_USED_AFTER_CLOSE>
                        <!-- Silence ambient streams siblings so the build outcome reflects only the rule under test. -->
                        <STREAMS_NOT_CLOSED>OFF</STREAMS_NOT_CLOSED>
                        <STREAMS_CLOSE_NO_TIMEOUT>OFF</STREAMS_CLOSE_NO_TIMEOUT>
                        <STREAMS_CLOSE_ZERO_DURATION>OFF</STREAMS_CLOSE_ZERO_DURATION>
                        <STREAMS_NO_SHUTDOWN_HOOK>OFF</STREAMS_NO_SHUTDOWN_HOOK>
                        <STREAMS_NO_STATE_LISTENER>OFF</STREAMS_NO_STATE_LISTENER>
                        <STREAMS_NO_UNCAUGHT_EXCEPTION_HANDLER>OFF</STREAMS_NO_UNCAUGHT_EXCEPTION_HANDLER>
                        <STREAMS_NO_GLOBAL_STATE_RESTORE_LISTENER>OFF</STREAMS_NO_GLOBAL_STATE_RESTORE_LISTENER>
                        <STREAMS_CLEANUP_IN_PROD>OFF</STREAMS_CLEANUP_IN_PROD>
                        <STREAMS_REMOVE_THREAD_NO_TIMEOUT>OFF</STREAMS_REMOVE_THREAD_NO_TIMEOUT>
                        <STREAMS_REMOVE_THREAD_ZERO_DURATION>OFF</STREAMS_REMOVE_THREAD_ZERO_DURATION>
                        <STREAMS_STORE_QUERY_PARAMETERS_NO_STALE_STORES>OFF</STREAMS_STORE_QUERY_PARAMETERS_NO_STALE_STORES>
                        <STREAMS_LOCAL_THREADS_METADATA_DEPRECATED>OFF</STREAMS_LOCAL_THREADS_METADATA_DEPRECATED>
                        <STREAMS_ALL_METADATA_FOR_STORE_DEPRECATED>OFF</STREAMS_ALL_METADATA_FOR_STORE_DEPRECATED>
                        <STREAMS_SET_UNCAUGHT_EXCEPTION_HANDLER_LEGACY_DEPRECATED>OFF</STREAMS_SET_UNCAUGHT_EXCEPTION_HANDLER_LEGACY_DEPRECATED>
                        <STREAMS_APPLICATION_ID_RANDOM>OFF</STREAMS_APPLICATION_ID_RANDOM>
                        <STREAMS_APPLICATION_ID_GENERIC>OFF</STREAMS_APPLICATION_ID_GENERIC>
                        <STREAMS_APPLICATION_ID_PLACEHOLDER>OFF</STREAMS_APPLICATION_ID_PLACEHOLDER>
                        <STREAMS_APPLICATION_SERVER_LOCALHOST>OFF</STREAMS_APPLICATION_SERVER_LOCALHOST>
                        <STREAMS_REPLICATION_FACTOR_ONE>OFF</STREAMS_REPLICATION_FACTOR_ONE>
                        <STREAMS_REPLICATION_FACTOR_TWO>OFF</STREAMS_REPLICATION_FACTOR_TWO>
                        <STREAMS_REPLICATION_FACTOR_BROKER_DEFAULT>OFF</STREAMS_REPLICATION_FACTOR_BROKER_DEFAULT>
                        <STREAMS_REPLICATION_FACTOR_TOO_HIGH>OFF</STREAMS_REPLICATION_FACTOR_TOO_HIGH>
                        <STREAMS_STATE_DIR_TMP>OFF</STREAMS_STATE_DIR_TMP>
                        <STREAMS_EOS_V1_DEPRECATED>OFF</STREAMS_EOS_V1_DEPRECATED>
                        <STREAMS_PROCESSING_GUARANTEE_AT_LEAST_ONCE_EXPLICIT>OFF</STREAMS_PROCESSING_GUARANTEE_AT_LEAST_ONCE_EXPLICIT>
                        <STREAMS_NUM_STREAM_THREADS_ONE>OFF</STREAMS_NUM_STREAM_THREADS_ONE>
                        <STREAMS_NUM_STREAM_THREADS_TOO_HIGH>OFF</STREAMS_NUM_STREAM_THREADS_TOO_HIGH>
                        <STREAMS_NUM_STANDBY_REPLICAS_ZERO>OFF</STREAMS_NUM_STANDBY_REPLICAS_ZERO>
                        <STREAMS_NUM_STANDBY_REPLICAS_TOO_HIGH>OFF</STREAMS_NUM_STANDBY_REPLICAS_TOO_HIGH>
                        <STREAMS_COMMIT_INTERVAL_TOO_LOW>OFF</STREAMS_COMMIT_INTERVAL_TOO_LOW>
                        <STREAMS_COMMIT_INTERVAL_TOO_HIGH>OFF</STREAMS_COMMIT_INTERVAL_TOO_HIGH>
                        <STREAMS_CACHE_DISABLED>OFF</STREAMS_CACHE_DISABLED>
                        <STREAMS_CACHE_KEY_DEPRECATED>OFF</STREAMS_CACHE_KEY_DEPRECATED>
                        <STREAMS_STATESTORE_CACHE_MAX_BYTES_ZERO>OFF</STREAMS_STATESTORE_CACHE_MAX_BYTES_ZERO>
                        <STREAMS_TOPOLOGY_OPTIMIZATION_NONE>OFF</STREAMS_TOPOLOGY_OPTIMIZATION_NONE>
                        <STREAMS_DESER_HANDLER_LOG_AND_CONTINUE>OFF</STREAMS_DESER_HANDLER_LOG_AND_CONTINUE>
                        <STREAMS_DEFAULT_DESERIALIZATION_EXCEPTION_HANDLER_LOG_AND_CONTINUE>OFF</STREAMS_DEFAULT_DESERIALIZATION_EXCEPTION_HANDLER_LOG_AND_CONTINUE>
                        <STREAMS_DEFAULT_TIMESTAMP_EXTRACTOR_LOG_AND_SKIP>OFF</STREAMS_DEFAULT_TIMESTAMP_EXTRACTOR_LOG_AND_SKIP>
                        <STREAMS_DEFAULT_TIMESTAMP_EXTRACTOR_WALL_CLOCK>OFF</STREAMS_DEFAULT_TIMESTAMP_EXTRACTOR_WALL_CLOCK>
                        <STREAMS_PRODUCTION_EXCEPTION_HANDLER_ALWAYS_CONTINUE>OFF</STREAMS_PRODUCTION_EXCEPTION_HANDLER_ALWAYS_CONTINUE>
                        <STREAMS_DEFAULT_DSL_STORE_INMEMORY>OFF</STREAMS_DEFAULT_DSL_STORE_INMEMORY>
                        <STREAMS_DEFAULT_DSL_STORE_KEY_DEPRECATED>OFF</STREAMS_DEFAULT_DSL_STORE_KEY_DEPRECATED>
                        <STREAMS_MAX_TASK_IDLE_MS_HIGH>OFF</STREAMS_MAX_TASK_IDLE_MS_HIGH>
                        <STREAMS_ACCEPTABLE_RECOVERY_LAG_ZERO>OFF</STREAMS_ACCEPTABLE_RECOVERY_LAG_ZERO>
                        <STREAMS_MAX_WARMUP_REPLICAS_ZERO>OFF</STREAMS_MAX_WARMUP_REPLICAS_ZERO>
                        <STREAMS_RACK_AWARE_ASSIGNMENT_STRATEGY_NONE>OFF</STREAMS_RACK_AWARE_ASSIGNMENT_STRATEGY_NONE>
                        <STREAMS_TASK_TIMEOUT_MS_ZERO>OFF</STREAMS_TASK_TIMEOUT_MS_ZERO>
                        <STREAMS_TASK_TIMEOUT_MS_TOO_HIGH>OFF</STREAMS_TASK_TIMEOUT_MS_TOO_HIGH>
                        <STREAMS_PROBING_REBALANCE_INTERVAL_MS_TOO_LOW>OFF</STREAMS_PROBING_REBALANCE_INTERVAL_MS_TOO_LOW>
                        <STREAMS_PROBING_REBALANCE_INTERVAL_MS_TOO_HIGH>OFF</STREAMS_PROBING_REBALANCE_INTERVAL_MS_TOO_HIGH>
                        <STREAMS_BUFFERED_RECORDS_PER_PARTITION_TOO_LOW>OFF</STREAMS_BUFFERED_RECORDS_PER_PARTITION_TOO_LOW>
                        <STREAMS_BUFFERED_RECORDS_PER_PARTITION_TOO_HIGH>OFF</STREAMS_BUFFERED_RECORDS_PER_PARTITION_TOO_HIGH>
                        <STREAMS_REPARTITION_PURGE_INTERVAL_MS_TOO_LOW>OFF</STREAMS_REPARTITION_PURGE_INTERVAL_MS_TOO_LOW>
                        <STREAMS_REPARTITION_PURGE_INTERVAL_MS_TOO_HIGH>OFF</STREAMS_REPARTITION_PURGE_INTERVAL_MS_TOO_HIGH>
                        <STREAMS_WINDOWSTORE_CHANGELOG_ADDITIONAL_RETENTION_MS_TOO_HIGH>OFF</STREAMS_WINDOWSTORE_CHANGELOG_ADDITIONAL_RETENTION_MS_TOO_HIGH>
                        <STREAMS_GLOBAL_CONSUMER_AUTO_OFFSET_RESET_LATEST>OFF</STREAMS_GLOBAL_CONSUMER_AUTO_OFFSET_RESET_LATEST>
                        <STREAMS_RESTORE_CONSUMER_AUTO_OFFSET_RESET_LATEST>OFF</STREAMS_RESTORE_CONSUMER_AUTO_OFFSET_RESET_LATEST>
                        <STREAMS_RETRIES_CONFIG_DEPRECATED>OFF</STREAMS_RETRIES_CONFIG_DEPRECATED>
                        <STREAMS_PROPERTIES_ACCEPTABLE_RECOVERY_LAG_ABSENT>OFF</STREAMS_PROPERTIES_ACCEPTABLE_RECOVERY_LAG_ABSENT>
                        <STREAMS_PROPERTIES_BOOTSTRAP_SERVERS_ABSENT>OFF</STREAMS_PROPERTIES_BOOTSTRAP_SERVERS_ABSENT>
                        <STREAMS_PROPERTIES_CLIENT_RACK_ABSENT>OFF</STREAMS_PROPERTIES_CLIENT_RACK_ABSENT>
                        <STREAMS_PROPERTIES_COMMIT_INTERVAL_MS_ABSENT>OFF</STREAMS_PROPERTIES_COMMIT_INTERVAL_MS_ABSENT>
                        <STREAMS_PROPERTIES_DEFAULT_DESERIALIZATION_EXCEPTION_HANDLER_ABSENT>OFF</STREAMS_PROPERTIES_DEFAULT_DESERIALIZATION_EXCEPTION_HANDLER_ABSENT>
                        <STREAMS_PROPERTIES_DEFAULT_DSL_STORE_ABSENT>OFF</STREAMS_PROPERTIES_DEFAULT_DSL_STORE_ABSENT>
                        <STREAMS_PROPERTIES_DEFAULT_KEY_SERDE_ABSENT>OFF</STREAMS_PROPERTIES_DEFAULT_KEY_SERDE_ABSENT>
                        <STREAMS_PROPERTIES_DEFAULT_PRODUCTION_EXCEPTION_HANDLER_ABSENT>OFF</STREAMS_PROPERTIES_DEFAULT_PRODUCTION_EXCEPTION_HANDLER_ABSENT>
                        <STREAMS_PROPERTIES_DEFAULT_TIMESTAMP_EXTRACTOR_ABSENT>OFF</STREAMS_PROPERTIES_DEFAULT_TIMESTAMP_EXTRACTOR_ABSENT>
                        <STREAMS_PROPERTIES_DEFAULT_VALUE_SERDE_ABSENT>OFF</STREAMS_PROPERTIES_DEFAULT_VALUE_SERDE_ABSENT>
                        <STREAMS_PROPERTIES_MAX_TASK_IDLE_MS_ABSENT>OFF</STREAMS_PROPERTIES_MAX_TASK_IDLE_MS_ABSENT>
                        <STREAMS_PROPERTIES_MAX_WARMUP_REPLICAS_ABSENT>OFF</STREAMS_PROPERTIES_MAX_WARMUP_REPLICAS_ABSENT>
                        <STREAMS_PROPERTIES_NUM_STANDBY_REPLICAS_ABSENT>OFF</STREAMS_PROPERTIES_NUM_STANDBY_REPLICAS_ABSENT>
                        <STREAMS_PROPERTIES_NUM_STREAM_THREADS_ABSENT>OFF</STREAMS_PROPERTIES_NUM_STREAM_THREADS_ABSENT>
                        <STREAMS_PROPERTIES_PROBING_REBALANCE_INTERVAL_MS_ABSENT>OFF</STREAMS_PROPERTIES_PROBING_REBALANCE_INTERVAL_MS_ABSENT>
                        <STREAMS_PROPERTIES_PROCESSING_EXCEPTION_HANDLER_ABSENT>OFF</STREAMS_PROPERTIES_PROCESSING_EXCEPTION_HANDLER_ABSENT>
                        <STREAMS_PROPERTIES_PROCESSING_GUARANTEE_ABSENT>OFF</STREAMS_PROPERTIES_PROCESSING_GUARANTEE_ABSENT>
                        <STREAMS_PROPERTIES_RACK_AWARE_ASSIGNMENT_TAGS_ABSENT>OFF</STREAMS_PROPERTIES_RACK_AWARE_ASSIGNMENT_TAGS_ABSENT>
                        <STREAMS_PROPERTIES_REPLICATION_FACTOR_ABSENT>OFF</STREAMS_PROPERTIES_REPLICATION_FACTOR_ABSENT>
                        <STREAMS_PROPERTIES_STATE_DIR_ABSENT>OFF</STREAMS_PROPERTIES_STATE_DIR_ABSENT>
                        <STREAMS_PROPERTIES_STATESTORE_CACHE_MAX_BYTES_ABSENT>OFF</STREAMS_PROPERTIES_STATESTORE_CACHE_MAX_BYTES_ABSENT>
                        <STREAMS_PROPERTIES_TASK_TIMEOUT_MS_ABSENT>OFF</STREAMS_PROPERTIES_TASK_TIMEOUT_MS_ABSENT>
                        <STREAMS_PROPERTIES_TOPOLOGY_OPTIMIZATION_ABSENT>OFF</STREAMS_PROPERTIES_TOPOLOGY_OPTIMIZATION_ABSENT>
                        <STREAMS_BUILDER_BUILD_NO_PROPERTIES>OFF</STREAMS_BUILDER_BUILD_NO_PROPERTIES>
                        <STREAMS_STREAM_NO_CONSUMED>OFF</STREAMS_STREAM_NO_CONSUMED>
                        <STREAMS_TO_NO_PRODUCED>OFF</STREAMS_TO_NO_PRODUCED>
                        <CLIENT_ID_MISSING>OFF</CLIENT_ID_MISSING>
                        <KAFKA_CLIENTS_CVE_CONFIG_PROVIDER>OFF</KAFKA_CLIENTS_CVE_CONFIG_PROVIDER>
                        <KAFKA_CLIENTS_CVE_BUFFER_POOL>OFF</KAFKA_CLIENTS_CVE_BUFFER_POOL>
                        <KAFKA_CLIENTS_CVE_SCRAM_REPLAY>OFF</KAFKA_CLIENTS_CVE_SCRAM_REPLAY>
                    </severities>
                </configuration>
                <executions>
                    <execution>
                        <id>lint</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
